# Copy this file to ".env" and change the password. Never commit ".env".
#   PowerShell:  Copy-Item .env.example .env

# --- MongoDB (official image) ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change_me_before_use
MONGO_DB_NAME=employee_db

# --- Ports published on your computer ---
FRONTEND_PORT=8080
BACKEND_PORT=5000
# MongoDB is published on localhost only, for tools such as MongoDB Compass
MONGO_HOST_PORT=27018

# --- Backend behaviour ---
# Insert sample employees on first start when the collection is empty
SEED_ON_START=true
# Allowed browser origins for direct API calls (nginx proxying does not need CORS)
CORS_ORIGIN=*
